# A pinentry-only Catppuccin Mocha variant; flat surfaces instead of bevels.
[%General]
author=stoletop
comment=Roomy, square Catppuccin pinentry
composite=false
layout_margin=12
layout_spacing=8
button_contents_shift=false
animate_states=true

[Hacks]
iconless_pushbutton=true

[GeneralColors]
window.color=#11111b
base.color=#313244
alt.base.color=#45475a
button.color=#89b4fa
light.color=#45475a
mid.light.color=#45475a
dark.color=#181825
mid.color=#313244
highlight.color=#89b4fa
inactive.highlight.color=#45475a
text.color=#cdd6f4
window.text.color=#cdd6f4
button.text.color=#11111b
highlight.text.color=#11111b
disabled.text.color=#585b70
tooltip.base.color=#181825
tooltip.text.color=#cdd6f4
link.color=#89b4fa
link.visited.color=#cba6f7

[Window]
frame=false
interior=false

[Dialog]
inherits=Window

[PanelButtonCommand]
frame=false
interior=true
interior.element=pinentry-button
min_width=110
min_height=40
text.margin=true
text.margin.left=18
text.margin.right=18
text.margin.top=8
text.margin.bottom=8
text.bold=true
text.normal.color=#11111b
text.focus.color=#11111b
text.press.color=#11111b
text.toggle.color=#11111b
text.disabled.color=#585b70

[PanelButtonTool]
inherits=PanelButtonCommand
min_width=40
text.margin.left=8
text.margin.right=8

[LineEdit]
frame=false
interior=true
interior.element=pinentry-input
min_width=300
min_height=40
text.margin=true
text.margin.left=10
text.margin.right=10
text.margin.top=6
text.margin.bottom=6
text.normal.color=#cdd6f4
text.focus.color=#cdd6f4

# Keep an explicit keyboard-focus cue, even though normal surfaces are borderless.
[Focus]
frame=true
interior=false
frame.element=pinentry-focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
